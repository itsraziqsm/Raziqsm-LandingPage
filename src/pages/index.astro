---
import "../styles/global.css";
import { categories, skills, categoryOf } from "../data/skills";
import SkillCard from "../components/SkillCard.astro";
import Scene from "../components/Scene.astro";

const total = skills.length;
const first = categoryOf(skills[0].category);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const num = (n: number) => String(n).padStart(2, "0");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>raziqsm · skills</title>
    <meta name="description" content="12 Claude Code skills for video, motion, Blender and 3D web — curated by raziqsm." />
    <meta name="theme-color" content="#f3ece4" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body class="min-h-svh">
    <!-- header -->
    <header class="fixed inset-x-0 top-0 z-50 flex items-center justify-between px-4 py-4 sm:px-8 sm:py-5">
      <a href={`${base}/`} class="flex items-center gap-2 text-[13px] sm:text-sm">
        <span class="grid size-7 place-items-center rounded-lg bg-brand shadow-sm">
          <svg viewBox="0 0 20 14" class="w-4" aria-hidden="true">
            <rect width="20" height="14" rx="4" fill="#fff"></rect>
            <rect x="5" y="4" width="2.5" height="5" rx="1" fill="#141110"></rect>
            <rect x="12.5" y="4" width="2.5" height="5" rx="1" fill="#141110"></rect>
          </svg>
        </span>
        <span class="font-bold tracking-tight">raziqsm ·</span>
        <span class="text-muted">skills</span>
      </a>
      <div class="flex items-center gap-2 rounded-full bg-white/80 px-3 py-1.5 font-mono text-[11px] shadow-sm backdrop-blur sm:text-xs">
        <svg viewBox="0 0 10 13" class="w-2.5 fill-brand" aria-hidden="true"><path d="M0 0h10v13L5 9.5 0 13z"></path></svg>
        <span><b id="counter">01</b> <span class="text-muted">/ {total} installed</span></span>
      </div>
    </header>

    <main>
      <!-- pinned showcase -->
      <section id="showcase" class="relative flex h-svh flex-col overflow-hidden px-4 pt-[72px] pb-12 sm:px-8 sm:pt-[84px]">
        <div class="mx-auto flex w-full max-w-[600px] items-baseline gap-3" style={`--cat:${first.color}`} id="cat-label">
          <span class="font-mono text-xs text-[var(--cat)] sm:text-sm"
            ><span id="cat-num">01</span> / {num(categories.length)}</span
          >
          <span class="relative inline-block h-[1.15em] overflow-hidden font-serif text-[clamp(2.6rem,9vw,4.5rem)] leading-[1.1] italic text-[var(--cat)]">
            <span id="cat-name" class="inline-block">{first.label}</span>
          </span>
        </div>

        <div id="stage-wrap" class="relative mt-3 flex-1 sm:mt-5">
          <div id="stage" class="absolute inset-x-0 top-0 origin-top">
            {skills.map((skill, i) => <SkillCard skill={skill} index={i} total={total} />)}
          </div>
        </div>

        <p id="scroll-hint" class="pointer-events-none absolute bottom-14 left-1/2 -translate-x-1/2 font-mono text-[11px] text-muted">
          scroll ↓
        </p>

        <!-- segmented progress -->
        <div class="absolute inset-x-4 bottom-5 z-30 flex gap-1.5 sm:inset-x-8" aria-hidden="true">
          {
            skills.map((s, i) => (
              <span class="h-[3px] flex-1 overflow-hidden rounded-full bg-black/8">
                <span
                  class="seg block h-full w-full origin-left scale-x-0 rounded-full"
                  data-i={i}
                  style={`background:${categoryOf(s.category).color}`}
                />
              </span>
            ))
          }
        </div>
      </section>

      <!-- final grid -->
      <section id="finale" class="relative mx-auto max-w-[1100px] px-4 pt-24 pb-36 sm:px-8 sm:pt-32">
        <h2 class="font-serif text-[clamp(3rem,10vw,6rem)] leading-[0.95] tracking-[-0.02em]">
          {total} skills.<br />One <em class="text-brand">3D studio.</em>
        </h2>

        <ul class="mt-8 grid grid-cols-2 gap-2.5 sm:mt-12 sm:gap-3 lg:grid-cols-3">
          {
            skills.map((s, i) => {
              const c = categoryOf(s.category);
              return (
                <li class="grid-card">
                  <a
                    href={`https://github.com/${s.repo}`}
                    target="_blank"
                    rel="noopener"
                    class="flex h-full flex-col gap-2 rounded-2xl bg-white p-2 sm:flex-row sm:items-center sm:gap-3 sm:p-2.5 shadow-[0_10px_30px_-18px_rgb(60_30_10/0.35)] transition hover:-translate-y-0.5 hover:shadow-[0_18px_40px_-18px_rgb(60_30_10/0.45)]"
                  >
                    <span class="block aspect-[4/3] w-full shrink-0 overflow-hidden rounded-xl sm:w-[42%]">
                      <Scene prop={s.prop} tint={c.tint} color={c.color} compact seed={i} />
                    </span>
                    <span class="min-w-0 px-1 pb-1 sm:p-0">
                      <span class="block font-mono text-[10px] font-bold tracking-[0.15em] uppercase" style={`color:${c.color}`}>
                        {c.short}
                      </span>
                      <span class="block text-base leading-tight font-extrabold sm:text-lg tracking-[-0.03em] break-words">{s.name}</span>
                      <span class="block truncate font-mono text-[11px] text-muted">{s.repo.split("/")[0]}</span>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>

        <div class="sticky bottom-5 mt-12">
          <button
            id="cta"
            type="button"
            title={`Copy all ${total} install commands`}
            class="flex w-full items-center justify-center gap-2 rounded-full bg-ink px-6 py-4 text-sm font-bold text-white shadow-xl transition hover:bg-black sm:text-base"
          >
            <svg viewBox="0 0 10 13" class="w-2.5 fill-brand" aria-hidden="true"><path d="M0 0h10v13L5 9.5 0 13z"></path></svg>
            <span id="cta-label">bookmark this · install them tonight</span>
          </button>
        </div>
      </section>
    </main>

    <footer class="px-4 pb-8 text-center font-mono text-[11px] text-muted">
      © {new Date().getFullYear()} raziqsm
    </footer>

    <div
      id="toast"
      role="status"
      class="pointer-events-none fixed bottom-24 left-1/2 z-50 -translate-x-1/2 translate-y-2 rounded-full bg-ink px-4 py-2 font-mono text-xs text-white opacity-0 transition"
    >
    </div>

    <script>
      import { initShowcase } from "../scripts/showcase";
      initShowcase();
    </script>
  </body>
</html>
