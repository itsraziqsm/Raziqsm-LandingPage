---
import type { Skill } from "../data/skills";
import { categoryOf } from "../data/skills";
import Scene from "./Scene.astro";

interface Props {
  skill: Skill;
  index: number;
  total: number;
}

const { skill, index, total } = Astro.props;
const cat = categoryOf(skill.category);
const [owner, ...rest] = skill.repo.split("/");
const num = (n: number) => String(n).padStart(2, "0");
---

<article
  class="skill-card absolute inset-x-0 top-0 mx-auto w-[min(600px,calc(100vw-32px))] overflow-hidden rounded-2xl bg-white shadow-[0_30px_60px_-25px_rgb(60_30_10/0.35),0_2px_6px_rgb(0_0_0/0.06)] will-change-transform"
  data-index={index}
  data-category={cat.id}
  style={`--cat:${cat.color}`}
>
  <!-- browser chrome -->
  <div class="flex items-center gap-3 border-b border-black/5 bg-[#fbf9f7] px-3 py-2">
    <div class="flex gap-1.5">
      <span class="size-2 rounded-full" style={`background:${cat.color}`}></span>
      <span class="size-2 rounded-full bg-black/15"></span>
      <span class="size-2 rounded-full bg-black/15"></span>
    </div>
    <a
      href={`https://github.com/${skill.repo}`}
      target="_blank"
      rel="noopener"
      class="min-w-0 flex-1 truncate rounded-md bg-black/[0.04] px-2.5 py-1 font-mono text-[11px] text-muted hover:text-ink sm:text-xs"
    >
      github.com/<span class="font-semibold text-ink">{owner}/{rest.join("/")}</span>
    </a>
  </div>

  <!-- scene -->
  <div class="relative aspect-[16/8]">
    <Scene prop={skill.prop} tint={cat.tint} color={cat.color} chip={skill.chip} seed={index} />
    <span
      class="absolute right-3 top-3 rounded-full px-2 py-0.5 font-mono text-[10px] font-bold text-white sm:text-[11px]"
      style={`background:${cat.color}`}
    >
      {num(index + 1)} / {total}
    </span>
  </div>

  <!-- body -->
  <div class="grid gap-4 p-4 sm:grid-cols-[1fr_minmax(0,0.95fr)] sm:items-end sm:p-5">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <span class="font-mono text-[10px] font-bold uppercase tracking-[0.15em] sm:text-[11px]" style={`color:${cat.color}`}>
          {cat.short}
        </span>
        {
          skill.badge && (
            <span class="rounded-full bg-ink px-2 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-white">
              ● {skill.badge}
            </span>
          )
        }
      </div>
      <h3 class="mt-1 text-[clamp(1.75rem,6vw,2.6rem)] leading-[1] font-extrabold tracking-[-0.04em]">{skill.name}</h3>
      <p class="mt-2 text-sm leading-snug text-ink/80 sm:text-[15px]">{skill.description}</p>
      <div class="mt-3 flex gap-2">
        <span
          class="rounded-full px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-wider text-white"
          style={`background:${cat.color}`}>{skill.tag}</span
        >
        <span class="rounded-full border border-ink px-3 py-1 font-mono text-[10px] font-bold">★ {skill.stars}</span>
      </div>
    </div>

    <!-- terminal -->
    <button
      type="button"
      class="terminal group min-h-[104px] w-full cursor-copy rounded-xl bg-term p-3 text-left font-mono text-[11px] leading-relaxed text-white/90 shadow-[0_18px_30px_-16px_rgb(0_0_0/0.6)] sm:text-xs"
      data-command={skill.command}
      aria-label={`Copy install command for ${skill.name}`}
    >
      <span class="mb-2 flex items-center gap-1.5 text-[9px] tracking-[0.2em] text-white/40 uppercase">
        <span class="size-1.5 rounded-full bg-white/25"></span><span class="size-1.5 rounded-full bg-white/25"></span><span
          class="size-1.5 rounded-full bg-white/25"></span>
        <span class="ml-1">claude code</span>
        <span class="copy-hint ml-auto tracking-normal normal-case opacity-0 transition-opacity group-hover:opacity-100">click to copy</span>
      </span>
      <span class="block break-all"
        ><span style={`color:${cat.color}`}>›</span> <span class="cmd">{skill.command}</span></span
      >
      <span class="done block text-[#5fd39a]">✓ installed</span>
    </button>
  </div>
</article>
