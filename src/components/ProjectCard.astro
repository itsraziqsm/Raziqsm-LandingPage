---
import type { Lang, Project } from "../data/portfolio";
import { catVars, categoryOf, projectHref, projectTitle, projectBar, workItems } from "../data/portfolio";
import { t, ui } from "../i18n";
import Scene from "./Scene.astro";

interface Props {
  project: Project;
  index: number;
  total: number;
  lang: Lang;
}

const { project: p, index, total, lang } = Astro.props;
const cat = categoryOf(p.category);
// category number follows the order categories first appear in the card stack
const catIndex = [...new Set(workItems.map((w) => w.category))].indexOf(cat.id);
const num = (n: number) => String(n).padStart(2, "0");
const href = projectHref(p);
const title = projectTitle(p, lang);
const [host, ...path] = projectBar(p).split("/");
const Link = href ? "a" : "span";
const linkAttrs = href ? { href, target: "_blank", rel: "noopener" } : {};
---

<article
  class="work-card absolute inset-x-0 top-0 mx-auto w-[min(600px,calc(100vw-32px))] overflow-hidden rounded-2xl bg-surface shadow-[0_30px_60px_-25px_rgb(60_30_10/0.35),0_2px_6px_rgb(0_0_0/0.06)] will-change-transform"
  data-cat-label={t(cat.label, lang)}
  data-cat-color={cat.color}
  data-cat-deep={cat.deep}
  style={catVars(cat)}
  data-cat-index={catIndex}
>
  <!-- browser chrome -->
  <div class="flex items-center gap-3 border-b border-ink/5 bg-surface-2 px-3 py-2">
    <div class="flex gap-1.5">
      <span class="size-2 rounded-full" style={`background:${cat.color}`}></span>
      <span class="size-2 rounded-full bg-ink/15"></span>
      <span class="size-2 rounded-full bg-ink/15"></span>
    </div>
    <Link
      {...linkAttrs}
      class="min-w-0 flex-1 truncate rounded-md bg-ink/[0.05] px-2.5 py-1 font-mono text-[11px] text-muted hover:text-ink sm:text-xs"
    >
      <span class="font-semibold text-ink">{host}</span>{path.length ? `/${path.join("/")}` : ""}
    </Link>
  </div>

  <!-- visual -->
  <div class="relative aspect-[16/8]">
    <Scene prop={p.prop} tint={cat.tint} color={cat.color} chip={p.chip} seed={index} image={p.image} pose={p.pose} />
    <span
      class="cat-bg absolute right-3 top-3 rounded-full px-2 py-0.5 font-mono text-[10px] font-bold sm:text-[11px]"
    >
      {num(index + 1)} / {num(total)}
    </span>
  </div>

  <!-- body -->
  <div class="grid gap-4 p-4 sm:grid-cols-[1fr_minmax(0,0.95fr)] sm:items-end sm:p-5">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <span class="cat-text font-mono text-[10px] font-bold uppercase tracking-[0.15em] sm:text-[11px]">
          {[t(p.role, lang), p.year].filter(Boolean).join(" · ")}
        </span>
        {
          p.badge && (
            <span class="rounded-full bg-ink px-2 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-on-ink">
              ● {t(p.badge, lang)}
            </span>
          )
        }
      </div>
      <h3 class="mt-1 text-[clamp(1.75rem,6vw,2.6rem)] leading-[1] font-extrabold tracking-[-0.04em]">
        <Link {...linkAttrs} class:list={[href && "hover:underline decoration-2 underline-offset-4", p.soon && "text-muted"]}>{title}</Link>
      </h3>
      <p class="mt-2 text-sm leading-snug text-ink/80 sm:text-[15px]">{t(p.description, lang)}</p>
      <div class="mt-3 flex flex-wrap gap-1.5">
        {
          p.stack.map((s, i) => (
            <span
              class:list={[
                "rounded-full px-2.5 py-1 font-mono text-[10px] font-bold",
                i === 0 ? "cat-bg" : "border border-ink",
              ]}
            >
              {s}
            </span>
          ))
        }
      </div>
    </div>

    <!-- terminal -->
    <div
      class="terminal min-h-[104px] w-full rounded-xl bg-term p-3 font-mono text-[11px] leading-relaxed text-white/90 shadow-[0_18px_30px_-16px_rgb(0_0_0/0.6)] sm:text-xs"
      data-command={p.command}
    >
      <span class="mb-2 flex items-center gap-1.5 text-[9px] tracking-[0.2em] text-white/60 uppercase">
        <span class="size-1.5 rounded-full bg-white/25"></span><span class="size-1.5 rounded-full bg-white/25"></span><span
          class="size-1.5 rounded-full bg-white/25"></span>
        <span class="ml-1">{[t(ui.terminal, lang), p.client].filter(Boolean).join(" · ")}</span>
      </span>
      <span class="block break-all"
        ><span style={`color:${cat.color}`}>›</span> <span class="cmd">{p.command}</span></span
      >
      {
        p.soon ? (
          <span class="done block text-white/65">… {p.result && t(p.result, lang)}</span>
        ) : (
          <span class="done block text-[#5fd39a]">✓ {p.result ? t(p.result, lang) : "ready"}</span>
        )
      }
    </div>
  </div>
</article>
