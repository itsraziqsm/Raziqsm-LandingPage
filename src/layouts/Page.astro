---
import "../styles/global.css";
import type { Lang } from "../data/portfolio";
import { mascot, profile, projects, stackItems, stackMode, categories, categoryOf, catVars, experience, tools, aiSkills, projectHref, projectTitle } from "../data/portfolio";
import { t, ui, accent } from "../i18n";
import ProjectCard from "../components/ProjectCard.astro";
import Scene from "../components/Scene.astro";
import serifUrl from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";
import serifItalicUrl from "@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const home = { en: `${base}/`, id: `${base}/id/` };
const total = stackItems.length;
const first = categoryOf(stackItems[0].category);
const stackCats = new Set(stackItems.map((p) => p.category)).size;
const navItems = [
  { href: "#work", label: ui.nav.work },
  { href: "#about", label: ui.nav.about },
  { href: "#contact", label: ui.nav.contact },
];
const toolGroups = tools.filter((g) => g.items.length);
const num = (n: number) => String(n).padStart(2, "0");
const title = `${profile.name} · ${t(profile.role, lang)}`;
const canonical = new URL(home[lang], Astro.site).href;
const ogImage = new URL(`${base}/og.jpg`, Astro.site).href;
const desc = t(profile.intro, lang);
const tr = (k: keyof typeof ui) => t(ui[k] as { en: string; id: string }, lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#f3ece4" />
    <!-- apply the saved / system theme before first paint (no flash) -->
    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem("theme"); } catch {}
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", t === "dark" ? "#131110" : "#f3ece4");
      })();
    </script>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.handle} />
    <meta property="og:locale" content={lang === "id" ? "id_ID" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${mascot.name} · ${profile.handle}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <!-- the hero heading's font: fetch it early instead of after the stylesheet -->
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalicUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="alternate" hreflang="en" href={new URL(home.en, Astro.site)} />
    <link rel="alternate" hreflang="id" href={new URL(home.id, Astro.site)} />
  </head>
  <body class="min-h-svh">
    <!-- ───────── header ───────── -->
    <header class="fixed inset-x-0 top-0 z-50 flex items-center justify-between gap-3 bg-linear-to-b from-paper via-paper/85 to-transparent px-4 pt-4 pb-6 sm:px-8 sm:pt-5 sm:pb-8">
      <a href={home[lang]} class="relative flex items-center gap-2 text-[13px] after:absolute after:-inset-y-1.5 after:inset-x-0 sm:text-sm">
        <img src={`${base}/${mascot.stickerSmall}`} alt={mascot.name} width="105" height="96" class="zeebo h-8 w-auto -rotate-6 sm:h-9" />
        <span class="font-bold tracking-tight">{profile.handle}</span>
        <span class="hidden text-muted sm:inline">· {t(profile.role, lang).toLowerCase()}</span>
      </a>

      <nav aria-label={tr("navLabel")} class="ml-auto hidden items-center gap-1 rounded-full bg-surface/70 p-1 text-sm shadow-sm backdrop-blur md:flex">
        {
          navItems.map((n) => (
            <a href={n.href} data-nav class="rounded-full px-3 py-1 transition hover:bg-ink/5 data-[active]:bg-ink data-[active]:text-on-ink">
              {t(n.label, lang)}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <div class="hidden rounded-full bg-surface/80 p-0.5 font-mono text-xs font-bold shadow-sm backdrop-blur md:flex" role="group" aria-label={tr("langLabel")}>
          {
            (["en", "id"] as const).map((l) => (
              <a
                href={home[l]}
                hreflang={l}
                data-lang-link
                class:list={["relative rounded-full px-3 py-1.5 uppercase after:absolute after:-inset-y-2 after:inset-x-0", l === lang ? "bg-ink text-on-ink" : "text-muted hover:text-ink"]}
                aria-current={l === lang ? "true" : undefined}
              >
                {l}
              </a>
            ))
          }
        </div>
        {
          /* only shown while the card stack is on screen (see initWork) */
          stackMode && (
            <div id="counter-wrap" aria-hidden="true" class="flex items-center gap-2 rounded-full bg-surface/80 font-mono text-[11px] whitespace-nowrap shadow-sm backdrop-blur sm:text-xs">
              <svg viewBox="0 0 10 13" class="w-2.5 shrink-0 fill-brand" aria-hidden="true"><path d="M0 0h10v13L5 9.5 0 13z"></path></svg>
              <span><b id="counter">01</b> <span class="text-muted">/ {num(total)}</span></span>
            </div>
          )
        }
        <button
          id="theme-toggle"
          type="button"
          class="theme-toggle relative grid size-9 shrink-0 after:absolute after:-inset-1 place-items-center rounded-full bg-surface/80 text-ink shadow-sm backdrop-blur transition hover:text-accent sm:size-9"
          data-label-dark={t(ui.themeToDark, lang)}
          data-label-light={t(ui.themeToLight, lang)}
          aria-label={t(ui.themeToDark, lang)}
        >
          <svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <!-- sun: core + rays (rays orbit on hover) -->
            <g class="sun">
              <circle cx="12" cy="12" r="4.2" fill="currentColor" stroke="none"></circle>
              <g class="rays">
                <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
              </g>
            </g>
            <!-- moon: crescent + stars (twinkle on hover) -->
            <g class="moon">
              <path d="M19.5 14.6A8 8 0 0 1 9.4 4.5a8 8 0 1 0 10.1 10.1Z" fill="currentColor" stroke="none"></path>
              <g class="stars" fill="currentColor" stroke="none">
                <path class="star" d="M17 3.2l.55 1.45L19 5.2l-1.45.55L17 7.2l-.55-1.45L15 5.2l1.45-.55Z"></path>
                <path class="star" d="M21 8.6l.38.97.97.38-.97.38L21 11.3l-.38-.97-.97-.38.97-.38Z"></path>
                <path class="star" d="M13.6 1.4l.3.75.75.3-.75.3-.3.75-.3-.75-.75-.3.75-.3Z"></path>
              </g>
            </g>
          </svg>
        </button>
        <button
          id="menu-toggle"
          type="button"
          class="menu-toggle relative grid size-9 shrink-0 place-items-center rounded-full bg-ink text-on-ink shadow-sm after:absolute after:-inset-1 md:hidden"
          aria-label={tr("menu")}
          aria-expanded="false"
          aria-controls="menu-panel"
        >
          <svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
            <path class="bar-1" d="M5 9h14"></path>
            <path class="bar-2" d="M5 15h14"></path>
          </svg>
        </button>
      </div>

      <!-- mobile menu -->
      <div id="menu-panel" data-open="false" class="menu-panel absolute inset-x-4 top-full -mt-3 rounded-3xl bg-surface p-3 shadow-[0_30px_60px_-20px_rgb(60_30_10/0.45)] ring-1 ring-ink/5 md:hidden">
        <nav aria-label={tr("navLabel")} class="grid">
          {
            navItems.map((n, i) => (
              <a
                href={n.href}
                data-nav
                class="group flex items-baseline gap-3 rounded-2xl px-4 py-3 font-serif text-4xl leading-none data-[active]:bg-ink/5"
              >
                <span class="font-mono text-[11px] text-muted">{num(i + 1)}</span>
                <span class="group-data-[active]:text-accent group-data-[active]:italic">{t(n.label, lang)}</span>
              </a>
            ))
          }
        </nav>
        <div class="mt-2 flex items-center justify-between gap-3 border-t border-ink/10 px-4 pt-3 pb-1">
          <span class="font-mono text-[11px] tracking-[0.15em] text-muted uppercase">{tr("langLabel")}</span>
          <div class="flex rounded-full bg-ink/5 p-0.5 font-mono text-xs font-bold" role="group" aria-label={tr("langLabel")}>
            {
              (["en", "id"] as const).map((l) => (
                <a
                  href={home[l]}
                  hreflang={l}
                  data-lang-link
                  class:list={["rounded-full px-4 py-2.5 uppercase", l === lang ? "bg-ink text-on-ink" : "text-muted"]}
                  aria-current={l === lang ? "true" : undefined}
                >
                  {l === "en" ? "English" : "Indonesia"}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </header>

    <main>
      <!-- ───────── hero ───────── -->
      <section id="top" class="relative mx-auto grid min-h-svh max-w-[1180px] items-center gap-12 px-4 pt-20 pb-16 sm:px-8 sm:pt-28 lg:grid-cols-[1.15fr_1fr] lg:gap-10">
        <div class="hero-in">
          <span class="inline-flex items-center gap-2 rounded-full bg-surface/80 px-3 py-1.5 font-mono text-[11px] shadow-sm">
            <span class:list={["size-2 rounded-full", profile.available ? "bg-[#2fbf71]" : "bg-muted"]}></span>
            {t(profile.availability, lang)}
          </span>
          <h1
            class="mt-6 font-serif text-[clamp(2.9rem,8vw,5.6rem)] leading-[0.95] tracking-[-0.02em]"
            set:html={accent(t(profile.headline, lang), "italic text-accent")}
          />
          <p class="mt-6 max-w-[52ch] text-base leading-relaxed text-ink/75 sm:text-lg">{t(profile.intro, lang)}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#work" class="rounded-full bg-ink px-6 py-3.5 text-sm font-bold text-on-ink shadow-lg transition hover:opacity-90">
              {tr("heroCta")} ↓
            </a>
            <a href="#contact" class="rounded-full border border-ink/80 px-6 py-3.5 text-sm font-bold transition hover:bg-ink hover:text-on-ink">
              {tr("heroContact")}
            </a>
          </div>
          <dl class="mt-10 flex gap-8 sm:gap-12">
            {
              profile.stats.map((s) => (
                <div>
                  <dt class="font-serif text-4xl sm:text-5xl">{s.value}</dt>
                  <dd class="mt-1 font-mono text-[11px] text-muted">{t(s.label, lang)}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="hero-in relative order-first mx-auto w-full max-w-[520px] lg:order-none">
          <div class="rotate-2 overflow-hidden rounded-2xl bg-surface shadow-[0_40px_80px_-30px_rgb(60_30_10/0.45)]">
            <div class="flex items-center gap-3 border-b border-ink/5 bg-surface-2 px-3 py-2">
              <div class="flex gap-1.5">
                <span class="size-2 rounded-full bg-brand"></span><span class="size-2 rounded-full bg-ink/15"></span><span
                  class="size-2 rounded-full bg-ink/15"></span>
              </div>
              <span class="flex-1 truncate rounded-md bg-ink/[0.05] px-2.5 py-1 font-mono text-[11px] text-muted">
                <span class="font-semibold text-ink">itsraziqsm</span>.github.io
              </span>
            </div>
            <div class="relative aspect-[16/9] sm:aspect-[5/4]">
              <Scene prop="burst" tint="#f6d9c8" color="#f26b2c" seed={42} pose={false} chip={`hi, I'm ${profile.name.toLowerCase()}`} />
              <!-- interactive 3D Zeebo; the still is shown until WebGL is ready -->
              <div
                id="zeebo-3d"
                data-src={`${base}/${mascot.model}`}
                class="absolute inset-x-0 bottom-0 top-[6%] cursor-pointer"
                title={`${mascot.name} 👋`}
              >
                <img
                  src={`${base}/${mascot.poses.wave}`}
                  alt={mascot.name}
                  class="zeebo-still zeebo absolute bottom-[2%] left-1/2 h-[92%] w-auto -translate-x-1/2 transition-opacity duration-500"
                  fetchpriority="high"
                />
              </div>
              <!-- touch screens / Save-Data: the 3D version loads only on request (see initZeebo) -->
              <button
                id="zeebo-3d-btn"
                type="button"
                hidden
                class="zeebo-3d-btn absolute top-3 right-3 z-10 inline-flex items-center gap-1.5 rounded-full bg-term/85 px-3 py-2 font-mono text-[11px] text-white shadow-lg backdrop-blur"
              >
                <svg viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
                  <path d="M8 1.5 14 4.75v6.5L8 14.5 2 11.25v-6.5Z M2 4.75 8 8l6-3.25M8 8v6.5"></path>
                </svg>
                <span class="idle-label">{tr("zeebo3d")}</span>
                <span class="loading-label">{tr("zeebo3dLoading")}</span>
              </button>
            </div>
          </div>
          <div class="absolute -bottom-6 -left-2 -rotate-3 rounded-xl bg-term px-4 py-3 font-mono text-[11px] text-white shadow-xl sm:-left-8 sm:text-xs">
            <span class="text-brand">›</span> whoami<br />
            <span class="text-[#5fd39a]">✓ {t(profile.role, lang).toLowerCase()} · {t(profile.location, lang).split(",")[0].toLowerCase()}</span>
          </div>
        </div>
      </section>

      <!-- ───────── work ─────────
           stackMode (≥ STACK_MIN real projects): pinned, scroll-driven card stack.
           otherwise (.is-list): the cards in normal flow, no scroll lock. -->
      <section
        id="work"
        class:list={[
          "relative px-4 sm:px-8",
          stackMode ? "flex h-svh flex-col overflow-hidden pt-[72px] pb-12 sm:pt-[84px]" : "is-list scroll-mt-4 pt-24 pb-6 sm:pt-28",
        ]}
      >
        <div class="mx-auto w-full max-w-[600px]">
          {
            stackMode ? (
              <div id="cat-label" style={catVars(first)}>
                <h2 class="flex items-baseline gap-2 font-mono text-[11px] font-bold tracking-[0.15em] text-muted uppercase">
                  {tr("workTitle")}
                  <span class="cat-text">
                    <span id="cat-num">01</span> / {num(stackCats)}
                  </span>
                </h2>
                <p
                  id="cat-clip"
                  class="cat-text h-[1.15em] overflow-hidden whitespace-nowrap font-serif text-[clamp(2.4rem,9vw,4.5rem)] leading-[1.1] italic"
                >
                  <span id="cat-name" class="inline-block origin-left">
                    {t(first.label, lang)}
                  </span>
                </p>
              </div>
            ) : (
              <h2 class="reveal font-serif text-[clamp(2.8rem,10vw,4.5rem)] leading-none" set:html={accent(tr("workHeading"), "italic text-accent")} />
            )
          }
        </div>

        <div id="stage-wrap" class:list={["relative", stackMode ? "mt-2 flex-1 sm:mt-4" : "mt-6 sm:mt-8"]}>
          <div id="stage" class:list={stackMode ? "absolute inset-x-0 top-0 origin-top" : "grid gap-8"}>
            {stackItems.map((p, i) => <ProjectCard project={p} index={i} total={total} lang={lang} list={!stackMode} />)}
          </div>
        </div>

        {
          stackMode && (
            <Fragment>
        <p id="scroll-hint" class="pointer-events-none absolute bottom-14 left-1/2 -translate-x-1/2 font-mono text-[11px] text-muted">
          {tr("scroll")} ↓
        </p>

        <div id="work-progress" class="absolute inset-x-4 bottom-5 z-30 flex gap-1.5 sm:inset-x-8" aria-hidden="true">
          {
            stackItems.map((p) => (
              <span class="h-[3px] flex-1 overflow-hidden rounded-full bg-ink/10">
                <span class="seg block h-full w-full origin-left scale-x-0 rounded-full" style={`background:${categoryOf(p.category).color}`} />
              </span>
            ))
          }
        </div>
            </Fragment>
          )
        }
      </section>

      <!-- ───────── all work grid ───────── -->
      <section id="all" class="relative mx-auto max-w-[1100px] px-4 pt-24 pb-10 sm:px-8 sm:pt-32">
        <h2
          class="reveal font-serif text-[clamp(3rem,10vw,6rem)] leading-[0.95] tracking-[-0.02em]"
          set:html={accent(tr("gridTitle").replace("{n}", String(categories.length)), "italic text-accent")}
        />
        <ul class="mt-8 grid grid-cols-2 gap-2.5 sm:mt-12 sm:gap-3 lg:grid-cols-4">
          {
            categories.map((c, i) => {
              const own = projects.filter((p) => p.category === c.id);
              return (
                <li class="grid-card">
                  <article
                    class="flex h-full flex-col rounded-2xl bg-surface p-2 shadow-[0_10px_30px_-18px_rgb(60_30_10/0.35)] sm:p-2.5"
                    style={catVars(c)}
                  >
                    <div class="aspect-[4/3] overflow-hidden rounded-xl">
                      <Scene prop={c.prop} tint={c.tint} color={c.color} compact seed={i + 3} pose={c.pose} />
                    </div>
                    <div class="flex flex-1 flex-col px-1.5 pt-3 pb-1.5">
                      <span class="cat-text font-mono text-[10px] font-bold tracking-[0.15em]">
                        {num(i + 1)} / {num(categories.length)}
                      </span>
                      <h3 class="mt-1 text-lg leading-tight font-extrabold tracking-[-0.03em] sm:text-xl">{t(c.label, lang)}</h3>
                      <p class="mt-1.5 text-[13px] leading-snug text-ink/75 sm:text-sm">{t(c.blurb, lang)}</p>
                      <ul class="mt-auto border-t border-ink/10 pt-2.5 font-mono text-[11px]">
                        {own.length ? (
                          own.map((p) => {
                            const href = projectHref(p);
                            return (
                              <li class="flex items-baseline justify-between gap-2 pt-1 first:pt-0">
                                {href ? (
                                  <a href={href} target="_blank" rel="noopener" class="truncate font-bold hover:text-accent">
                                    {projectTitle(p, lang)} ↗
                                  </a>
                                ) : (
                                  <span class="truncate font-bold">{projectTitle(p, lang)}</span>
                                )}
                                <span class="text-muted">{p.year}</span>
                              </li>
                            );
                          })
                        ) : (
                          <li class="text-muted">{tr("fieldSoon")}</li>
                        )}
                      </ul>
                    </div>
                  </article>
                </li>
              );
            })
          }
        </ul>
      </section>

      <!-- ───────── about ───────── -->
      <section id="about" class="mx-auto grid max-w-[1100px] gap-10 px-4 py-24 sm:px-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div class="reveal">
          <div class="-rotate-2 overflow-hidden rounded-2xl bg-surface p-2 shadow-[0_30px_60px_-25px_rgb(60_30_10/0.35)]">
            <div class="aspect-square overflow-hidden rounded-xl"><Scene prop="canvas" tint="#dcd8f6" color="#7559f2" seed={7} pose="think" mascotSize={70} /></div>
            <div class="flex items-end justify-between gap-2 px-2 pt-3 pb-1">
              <div>
                <p class="text-2xl font-extrabold tracking-[-0.03em]">{profile.name}</p>
                <p class="font-mono text-[11px] text-muted">{t(profile.role, lang)} · {t(profile.location, lang)}</p>
              </div>
              <span class="rounded-full bg-brand px-2.5 py-1 font-mono text-[10px] font-bold text-on-brand">@{profile.handle}</span>
            </div>
          </div>
        </div>

        <div>
          <h2 class="reveal font-serif text-[clamp(2.8rem,8vw,4.5rem)] leading-none" set:html={accent(tr("aboutTitle"), "italic text-accent")} />
          <p class="reveal mt-6 max-w-[60ch] text-lg leading-relaxed text-ink/80">{t(profile.intro, lang)}</p>

          <h3 class="reveal mt-12 font-mono text-[11px] font-bold tracking-[0.15em] text-muted uppercase">{tr("experience")}</h3>
          <ol class="mt-4 divide-y divide-ink/10 border-y border-ink/10">
            {
              experience.map((e) => (
                <li class="reveal grid gap-1 py-5 sm:grid-cols-[140px_1fr] sm:gap-6">
                  <span class="font-mono text-xs text-muted">{t(e.period, lang)}</span>
                  <div>
                    <p class="text-lg font-extrabold tracking-[-0.02em]">
                      {t(e.role, lang)} <span class="font-normal text-muted">· {e.org}</span>
                    </p>
                    <p class="mt-1 text-sm text-ink/70">{t(e.note, lang)}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- ───────── toolkit ───────── -->
      <section id="toolkit" class="mx-auto grid max-w-[1100px] gap-8 px-4 py-16 sm:px-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div>
          <h2 class="reveal font-serif text-[clamp(2.8rem,8vw,4.5rem)] leading-none" set:html={accent(tr("toolkitTitle"), "italic text-accent")} />
        </div>
        <div>
          <div class="grid gap-6 sm:grid-cols-2">
            {
              toolGroups.map((g, i) => (
                <div class="reveal">
                  <p class="cat-text font-mono text-[11px] font-bold tracking-[0.15em] uppercase" style={catVars(categories[i % categories.length])}>
                    {t(g.group, lang)}
                  </p>
                  <ul class="mt-3 flex flex-wrap gap-1.5">
                    {g.items.map((item) => (
                      <li class="rounded-full bg-surface px-3 py-1.5 text-sm font-semibold shadow-sm">{item}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>

          <!-- AI toolkit: collapsed by default so it does not outweigh the tools above -->
          <details class="ai-toolkit reveal mt-8 rounded-2xl bg-surface text-ink shadow-[0_20px_50px_-25px_rgb(60_30_10/0.35)] ring-1 ring-ink/5">
            <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-2xl px-5 py-4 font-mono text-[10px] tracking-[0.2em] text-muted uppercase">
              <span class="size-1.5 rounded-full bg-brand"></span><span class="size-1.5 rounded-full bg-ink/15"></span><span
                class="size-1.5 rounded-full bg-ink/15"></span>
              <span class="ml-1">{tr("aiToolkit")}</span>
              <span class="ml-auto rounded-full bg-ink/5 px-2 py-0.5 tracking-normal text-ink">{aiSkills.length}</span>
              <svg viewBox="0 0 12 12" class="chev size-3 shrink-0 transition-transform" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5"></path></svg>
            </summary>
            <ul class="grid gap-x-6 gap-y-2 px-5 pb-5 font-mono text-xs sm:grid-cols-2">
              {
                aiSkills.map((s) => (
                  <li class="truncate">
                    <span class="text-ok">✓</span>{" "}
                    <a href={`https://github.com/${s.repo}`} target="_blank" rel="noopener" class="hover:text-accent">
                      {s.name}
                    </a>{" "}
                    <span class="text-muted">· {t(s.category, lang)}</span>
                  </li>
                ))
              }
            </ul>
          </details>
        </div>
      </section>

      <!-- ───────── contact ───────── -->
      <section id="contact" class="mx-auto max-w-[1100px] px-4 pt-16 pb-10 sm:px-8">
        <div class="reveal relative overflow-hidden contact-card rounded-[28px] bg-surface px-6 py-14 text-ink shadow-[0_30px_70px_-30px_rgb(60_30_10/0.4)] ring-1 ring-ink/5 sm:px-12 sm:py-20">
          <span class="orb bob aspect-square right-[5%] top-[4%] w-10 sm:right-[8%] sm:top-[10%] sm:w-16 lg:right-[46%] lg:top-[10%] lg:w-12" style="--orb:#f26b2c"></span>
          <span class="orb bob-slow aspect-square right-[34%] bottom-[5%] hidden w-8 lg:block" style="--orb:#7559f2"></span>
          <!-- the "point" pose, mirrored so Zeebo points at the text -->
          <img
            src={`${base}/${mascot.poses.point}`}
            alt=""
            loading="lazy"
            decoding="async"
            class="zeebo bob-slow absolute right-1 bottom-0 h-28 w-auto -scale-x-100 sm:right-6 sm:h-44 lg:right-[5%] lg:h-[84%]"
          />
          <h2
            class="relative max-w-[14ch] font-serif text-[clamp(2.8rem,9vw,5.5rem)] leading-[0.95]"
            set:html={accent(tr("contactTitle"), "italic text-accent")}
          />
          <p class="relative mt-6 max-w-[48ch] text-ink/70 sm:text-lg">{tr("contactText")}</p>
          <div class="relative mt-10 flex flex-wrap items-center gap-3">
            <a href={`mailto:${profile.email}`} class="rounded-full bg-brand px-6 py-3.5 text-sm font-bold text-on-brand transition hover:brightness-110 sm:text-base">
              {profile.email}
            </a>
            <button
              type="button"
              data-copy={profile.email}
              data-toast={tr("copied")}
              class="rounded-full border border-ink/25 px-5 py-3.5 font-mono text-xs transition hover:bg-ink hover:text-on-ink"
            >
              {tr("copyEmail")}
            </button>
            {
              profile.cv && (
                <a href={profile.cv} class="rounded-full border border-ink/25 px-5 py-3.5 font-mono text-xs transition hover:bg-ink hover:text-on-ink">
                  {tr("cv")} ↓
                </a>
              )
            }
          </div>
          <ul class="relative mt-12 flex max-w-[calc(100%-6.5rem)] flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-muted sm:max-w-[60%]">
            {
              profile.socials.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener" class="hover:text-ink">
                    {s.label} ↗
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- floating CTA, desktop only (phones have Contact in the menu); visible between work grid and contact -->
      <a
        id="sticky-cta"
        href="#contact"
        inert
        class="fixed right-8 bottom-6 z-40 hidden translate-y-24 items-center justify-center gap-2 rounded-full bg-ink px-6 py-3.5 text-sm font-bold text-on-ink opacity-0 shadow-xl transition duration-300 md:flex"
      >
        <svg viewBox="0 0 10 13" class="w-2.5 fill-brand" aria-hidden="true"><path d="M0 0h10v13L5 9.5 0 13z"></path></svg>
        {tr("cta")}
      </a>
    </main>

    <footer class="mx-auto flex max-w-[1100px] flex-wrap justify-between gap-2 px-4 pt-6 pb-10 font-mono text-[11px] text-muted sm:px-8">
      <span>© {new Date().getFullYear()} {profile.handle}</span>
      <span>{tr("rights")}</span>
    </footer>

    <div
      id="toast"
      role="status"
      class="pointer-events-none fixed bottom-24 left-1/2 z-50 -translate-x-1/2 translate-y-2 rounded-full bg-ink px-4 py-2 font-mono text-xs text-on-ink opacity-0 transition"
    >
    </div>

    <script>
      import { initPage } from "../scripts/showcase";
      initPage();
    </script>
  </body>
</html>
